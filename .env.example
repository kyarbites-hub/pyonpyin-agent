# Server-only settings. Run python -m pyonpyin.manage init to create .env.
PYONPYIN_STORAGE=sqlite
PYONPYIN_DATABASE_PATH=data/runtime/pyonpyin.db
AUDIO_OUTPUT_DIR=data/runtime/audio
IMAGE_OUTPUT_DIR=data/runtime/images
PYONPYIN_ADMIN_PASSWORD=
PYONPYIN_SESSION_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8000
PYONPYIN_HTTPS=false
GOOGLE_SPREADSHEET_ID=
GOOGLE_TOKEN_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PYONPYIN_GEMINI_AUTOMATION_ENABLED=true
PYONPYIN_GITHUB_DISPATCH_ENABLED=false
PYONPYIN_GITHUB_TOKEN=
PYONPYIN_GITHUB_REPOSITORY=
PYONPYIN_GITHUB_REF=main
PYONPYIN_PUBLISHING_ENABLED=false
TTS_PROVIDER=gemini
PYONPYIN_TTS_ENABLED=true
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
# Optional alternative provider; Gemini TTS does not need Azure credentials.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=my-MM-NilarNeural
HOST=127.0.0.1
PORT=8000
